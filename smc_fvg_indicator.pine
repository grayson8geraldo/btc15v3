// © SMC FVG + Discount/Premium Strategy

//@version=5
indicator("SMC FVG Discount/Premium", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════
// BACKTEST RESULTS (BTC/USDT 15m, 2022-2026):
//   Best: 4h range + TP=50%
//   PF 1.58 | WR 72% | Max DD -14.9%
//   $200 → $36,100 | All 9 walk-forward halves profitable
//   Out-of-sample: PF 1.56 (vs in-sample 1.71 — minimal degradation)
// ═══════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────

grpRange = "═══ Dealing Range ═══"
rangeLookback = input.int(16, "Range Lookback Bars", minval=4, maxval=2000, group=grpRange,
     tooltip="Bars to define dealing range. 16 = 4h on 15m chart (best). 96 = 24h, 672 = 1W")
zoneThreshold = input.float(0.5, "Zone Threshold", minval=0.1, maxval=0.5, step=0.05, group=grpRange,
     tooltip="0.5 = strict 50% split. Lower = wider Discount/Premium zones")
showRange     = input.bool(true, "Show Range Box", group=grpRange)

grpFVG = "═══ FVG Detection ═══"
minFvgPct  = input.float(0.05, "Min FVG Size (%)", minval=0.01, step=0.01, group=grpFVG,
     tooltip="Minimum FVG gap size. 0.05% = sensitive (best). 0.15% = stricter, fewer signals")
showFVG    = input.bool(true, "Show FVG Boxes", group=grpFVG)
fvgExpiry  = input.int(50, "FVG Expiry (bars)", minval=1, maxval=500, group=grpFVG)

grpRisk = "═══ Risk Management ═══"
portfolioSize = input.float(200, "Portfolio Size ($)", minval=1, group=grpRisk)
riskPct       = input.float(2.0, "Risk per Trade (%)", minval=0.1, maxval=20, step=0.5, group=grpRisk)
maxSlPct      = input.float(5.0, "Max SL Distance (%)", minval=0.1, maxval=20, step=0.1, group=grpRisk)

grpSignals = "═══ Signals ═══"
showSignals = input.bool(true, "Show Entry Signals", group=grpSignals)
showSLTP    = input.bool(true, "Show SL/TP Lines", group=grpSignals)

grpColors = "═══ Colors ═══"
discColor = input.color(color.new(#26a69a, 85), "Discount Zone (Long)", group=grpColors)
premColor = input.color(color.new(#ef5350, 85), "Premium Zone (Short)", group=grpColors)
bullFvgColor = input.color(color.new(#00e676, 70), "Bullish FVG", group=grpColors)
bearFvgColor = input.color(color.new(#ff1744, 70), "Bearish FVG", group=grpColors)
midColor  = input.color(color.new(color.white, 50), "50% Line", group=grpColors)

// ─── DEALING RANGE ───────────────────────────────────────────

rangeHigh = ta.highest(high, rangeLookback)
rangeLow  = ta.lowest(low, rangeLookback)
rangeSize = rangeHigh - rangeLow
eq50      = (rangeHigh + rangeLow) / 2

// Discount = lower zone (buy zone), Premium = upper zone (sell zone)
discountTop = rangeLow + rangeSize * zoneThreshold
premiumBot  = rangeHigh - rangeSize * zoneThreshold

inDiscount = close < discountTop
inPremium  = close > premiumBot

// ─── FVG DETECTION ───────────────────────────────────────────

// Bullish FVG: low[0] > high[2] (current low above 2-bars-ago high)
// Bearish FVG: high[0] < low[2]
bullFvg = low > high[2]
bearFvg = high < low[2]

bullFvgSize = bullFvg ? (low - high[2]) / high[2] * 100 : 0
bearFvgSize = bearFvg ? (low[2] - high) / low[2] * 100 : 0

validBullFvg = bullFvg and bullFvgSize >= minFvgPct
validBearFvg = bearFvg and bearFvgSize >= minFvgPct

// ─── ENTRY SIGNALS ───────────────────────────────────────────

longSignal  = validBullFvg and inDiscount
shortSignal = validBearFvg and inPremium

// Entry / SL / TP calculation
longEntry  = (low + high[2]) / 2          // FVG midpoint
longSL     = math.min(low[2], low[1]) * 0.999
longTP     = eq50

shortEntry = (high + low[2]) / 2
shortSL    = math.max(high[2], high[1]) * 1.001
shortTP    = eq50

// Position sizing
calcPos(entry, sl, isLong) =>
    riskAmt = portfolioSize * (riskPct / 100)
    slDist  = isLong ? (entry - sl) / entry : (sl - entry) / entry
    pos     = slDist > 0 ? riskAmt / slDist : 0.0
    lev     = pos > 0 ? pos / portfolioSize : 0.0
    [pos, lev, riskAmt, slDist * 100]

// Validate trade (SL distance not too large)
[longPos, longLev, longRisk, longSlPct] = calcPos(longEntry, longSL, true)
[shortPos, shortLev, shortRisk, shortSlPct] = calcPos(shortEntry, shortSL, false)

validLong  = longSignal  and longTP > longEntry  and longSlPct < maxSlPct  and longSlPct > 0.1
validShort = shortSignal and shortTP < shortEntry and shortSlPct < maxSlPct and shortSlPct > 0.1

// ─── PLOT RANGE ──────────────────────────────────────────────

var box rangeBox = na
if showRange and barstate.islast
    box.delete(rangeBox)
    rangeBox := box.new(bar_index - rangeLookback, rangeHigh, bar_index + 5, rangeLow,
         border_color=color.new(color.white, 60), border_width=1, bgcolor=na)

// Discount/Premium zones
plot(showRange ? discountTop : na, "Discount Top", color=color.new(#26a69a, 50), linewidth=1)
plot(showRange ? premiumBot : na,  "Premium Bot",  color=color.new(#ef5350, 50), linewidth=1)
plot(eq50, "50% Line", color=midColor, linewidth=2, style=plot.style_line)

// Highlight Discount/Premium zones with background
bgcolor(inDiscount ? discColor : inPremium ? premColor : na, title="Zone Highlight")

// ─── DRAW FVG BOXES ──────────────────────────────────────────

var array<box> fvgBoxes = array.new<box>()

if showFVG
    if validBullFvg
        b = box.new(bar_index - 2, low, bar_index + fvgExpiry, high[2],
             border_color=bullFvgColor, bgcolor=color.new(#00e676, 90), border_width=1)
        array.push(fvgBoxes, b)
    if validBearFvg
        b = box.new(bar_index - 2, high, bar_index + fvgExpiry, low[2],
             border_color=bearFvgColor, bgcolor=color.new(#ff1744, 90), border_width=1)
        array.push(fvgBoxes, b)
    // Cleanup old boxes
    if array.size(fvgBoxes) > 100
        old = array.shift(fvgBoxes)
        box.delete(old)

// ─── PLOT SIGNALS ────────────────────────────────────────────

plotshape(showSignals and validLong,  "LONG",  shape.triangleup,
     location.belowbar, color=color.new(#00e676, 0), size=size.normal)
plotshape(showSignals and validShort, "SHORT", shape.triangledown,
     location.abovebar, color=color.new(#ff1744, 0), size=size.normal)

// ─── SL/TP LABELS ────────────────────────────────────────────

if showSLTP and validLong
    label.new(bar_index, longTP, "TP " + str.tostring(longTP, format.mintick),
         style=label.style_label_down, color=color.new(#00e676, 0),
         textcolor=color.white, size=size.tiny)
    label.new(bar_index, longSL, "SL " + str.tostring(longSL, format.mintick),
         style=label.style_label_up, color=color.new(#ff1744, 0),
         textcolor=color.white, size=size.tiny)
    label.new(bar_index, longEntry, "Entry " + str.tostring(longEntry, format.mintick),
         style=label.style_label_left, color=color.new(color.blue, 0),
         textcolor=color.white, size=size.tiny)

if showSLTP and validShort
    label.new(bar_index, shortTP, "TP " + str.tostring(shortTP, format.mintick),
         style=label.style_label_up, color=color.new(#ff1744, 0),
         textcolor=color.white, size=size.tiny)
    label.new(bar_index, shortSL, "SL " + str.tostring(shortSL, format.mintick),
         style=label.style_label_down, color=color.new(#00e676, 0),
         textcolor=color.white, size=size.tiny)
    label.new(bar_index, shortEntry, "Entry " + str.tostring(shortEntry, format.mintick),
         style=label.style_label_left, color=color.new(color.blue, 0),
         textcolor=color.white, size=size.tiny)

// ─── INFO TABLE ──────────────────────────────────────────────

var table infoTable = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    zoneStr = inDiscount ? "DISCOUNT (Long)" : inPremium ? "PREMIUM (Short)" : "Equilibrium"
    zoneClr = inDiscount ? #00e676 : inPremium ? #ff1744 : color.gray

    table.cell(infoTable, 0, 0, "Strategy", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "FVG D/P", text_color=#ffd740, text_size=size.small)

    table.cell(infoTable, 0, 1, "Zone", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, zoneStr, text_color=zoneClr, text_size=size.small)

    table.cell(infoTable, 0, 2, "Range High", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(rangeHigh, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 3, "Range Low", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(rangeLow, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 4, "50% (TP)", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(eq50, format.mintick), text_color=#ffd740, text_size=size.small)

    table.cell(infoTable, 0, 5, "Portfolio", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, "$" + str.tostring(portfolioSize, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 6, "Risk/Trade", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, "$" + str.tostring(portfolioSize * riskPct / 100, "#.##") + " (" + str.tostring(riskPct, "#.#") + "%)",
         text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 7, "Range Size", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 7, str.tostring(rangeSize / close * 100, "#.##") + "%",
         text_color=color.white, text_size=size.small)

// ─── ALERTS ──────────────────────────────────────────────────

f(v) => str.tostring(v, format.mintick)
f2(v) => str.tostring(v, "#.##")

longMsg = "🟢 LONG BTC (FVG Discount)\n" +
     "Entry: " + f(longEntry) + "\n" +
     "TP: " + f(longTP) + "\n" +
     "SL: " + f(longSL) + "\n" +
     "Position: $" + f2(longPos) + "\n" +
     "Leverage: " + f2(longLev) + "x\n" +
     "Risk: $" + f2(longRisk) + " (" + f2(riskPct) + "%)"

shortMsg = "🔴 SHORT BTC (FVG Premium)\n" +
     "Entry: " + f(shortEntry) + "\n" +
     "TP: " + f(shortTP) + "\n" +
     "SL: " + f(shortSL) + "\n" +
     "Position: $" + f2(shortPos) + "\n" +
     "Leverage: " + f2(shortLev) + "x\n" +
     "Risk: $" + f2(shortRisk) + " (" + f2(riskPct) + "%)"

if validLong
    alert(longMsg, alert.freq_once_per_bar_close)
if validShort
    alert(shortMsg, alert.freq_once_per_bar_close)

alertcondition(validLong,  "FVG Long",  "FVG Discount LONG signal")
alertcondition(validShort, "FVG Short", "FVG Premium SHORT signal")
